// ResultList (UI-CONTRACT §9): visible rows, selection presentation, and
// empty-state text. It never decides which command is executable - rows emit
// execute() and the parent resolves the primary action by command_id.
//
// Spec v0.2: the list height is `visible-rows * row-main` (window height is
// content-driven from this); rows beyond the visible window scroll inside
// the Flickable, and the viewport follows the keyboard selection.
import { Theme } from "theme.slint";
import { ResultItem, ResultRow, SectionHeader } from "result-row.slint";
export { ResultItem }

export component ResultList inherits Rectangle {
    in property <[ResultItem]> results;
    in-out property <int> selected-index;
    in property <int> visible-rows: 6;
    /// Progressive Disclosure (Spec v0.2 §20): the empty-state ("No
    /// results") only exists AFTER the user typed something; Initial state
    /// (empty query) shows nothing at all below the search box.
    in property <bool> show-empty: false;
    in property <string> empty-text: "No results";
    callback selection-changed(string);
    callback execute(string);
    // P3-E: right click on a row (spec §14 mouse UX)
    callback context-menu(string);
    // P3-I: keyboard traversal lives in Rust (cursor space = result space,
    // headers are skipped by construction); slint only reports the intent
    // and renders the returned row index.
    callback nav-requested(int);   // ±1 per row
    callback nav-home();
    callback nav-end();

    background: Theme.bg-surface;
    height: results.length > 0
        ? visible-rows * Theme.row-main
        : (show-empty ? 2 * Theme.row-main : 0px);

    if show-empty && results.length == 0 : VerticalLayout {
        alignment: center;
        spacing: Theme.space-1;
        Text {
            text: empty-text;
            color: Theme.text-tertiary;
            font-size: Theme.type-secondary;
            horizontal-alignment: center;
        }
        Text {
            text: "Check spelling or try fewer words";
            color: Theme.text-disabled;
            font-size: Theme.type-caption;
            horizontal-alignment: center;
        }
    }

    if results.length > 0 : Flickable {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        viewport-width: parent.width;
        viewport-height: results.length * Theme.row-main + Theme.space-2;
        // keep the keyboard-selected row in view (bottom-align at the end of
        // the list, otherwise shift only when the selection leaves the window)
        viewport-y: Math.min(0px, Math.max(
            self.height - self.viewport-height,
            -(root.selected-index * Theme.row-main + Theme.space-1)));

        VerticalLayout {
            padding: Theme.space-1;
            for r[index] in results : Rectangle {
                // P3-I: headers and results are DIFFERENT components in the
                // same display model — a header is structure (no TouchArea,
                // no hover, no execute), never a disabled result row.
                height: Theme.row-main;
                if r.is-header : SectionHeader {
                    label: r.header-label;
                }
                if !r.is-header : ResultRow {
                    item: r;
                    selected: index == root.selected-index;
                    // P3-I a11y: keyboard focus ring follows the cursor
                    // (selection) while the popup holds keyboard focus;
                    // kept as a separate property so future input models
                    // can set them independently.
                    keyboard-focused: index == root.selected-index;
                    execute => { root.execute(r.command-id); }
                    context-requested => { root.context-menu(r.command-id); }
                }
            }
        }
    }
}
