// ManagementWindow (P3.1-B0, ADR-0019): the standalone management surface.
// P3.1 UX revision: LEFT/RIGHT layout (uTools/Wox style) — a narrow menu
// column (1/7 of the width) and the detail pane (6/7). Pure projection: it
// renders host-provided models and forwards user actions upward.
//
// Lifecycle note: the host PARKS this window off-screen instead of hiding
// it (winit show/hide cycles leave windows invalid — same lesson as the
// popup); reopen = show + recenter.
import { Theme } from "theme.slint";
import { ThemedButton } from "primitives/themed-button.slint";

export struct PluginEntry {
    id: string,
    state-text: string,
    trust: string,
    version: string,
    enabled: bool,
    quarantined: bool,
}

export struct WorkflowEntry {
    name: string,
    path: string,
}

export struct SettingRow {
    label: string,
    value: string,
    action-id: string,
}

export struct WindowEntry {
    hwnd: string,
    title: string,
    plugin-id: string,
    pinned: bool,
    desktop: bool,
    follow-target: string,
}

export struct TargetEntry {
    hwnd: string,
    title: string,
}

export component ManagementWindow inherits Window {
    title: "Launcher Management";
    width: 780px;
    height: 520px;
    background: Theme.bg-canvas;

    in-out property <int> tab: 0;   // 0 general / 1 plugins / 2 workflows / 3 windows / 4 about
    in property <[SettingRow]> general-rows;
    in property <[PluginEntry]> plugins;
    in property <[WorkflowEntry]> workflows;
    in property <[WindowEntry]> windows;
    in property <[TargetEntry]> targets;
    in property <string> about-text;
    in-out property <string> follow-pick-hwnd;
    in-out property <string> follow-pick-title;

    callback tab-selected(int);
    callback setting-applied(string /* action-id */);
    callback plugin-toggled(string /* id */, bool /* enable */);
    callback workflow-deleted(string /* path */);
    callback pin-toggled(string /* hwnd */, bool /* pin */);
    callback desktop-pin-toggled(string /* hwnd */, bool /* desktop */);
    callback follow-set(string /* pin hwnd */, string /* target hwnd */, string /* target title */);
    callback follow-clear(string /* pin hwnd */);
    callback closed();

    // ---- left menu (1/7) ----
    Rectangle {
        x: 0;
        y: 0;
        width: parent.width / 7;
        height: parent.height;
        background: Theme.bg-surface;
        VerticalLayout {
            padding-top: Theme.spacing-md;
            spacing: Theme.spacing-xs;
            for t in [
                {i: 0, label: "General"},
                {i: 1, label: "Plugins"},
                {i: 2, label: "Workflows"},
                {i: 3, label: "Windows"},
                {i: 4, label: "About"},
            ]: Rectangle {
                height: 40px;
                background: root.tab == t.i ? Theme.bg-selected : transparent;
                animate background { duration: Theme.anim-ms * 2ms / 3; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.tab = t.i;
                        root.tab-selected(t.i);
                    }
                }
                Text {
                    text: t.label;
                    color: root.tab == t.i ? Theme.text-primary : Theme.text-secondary;
                    font-size: Theme.type-body;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: parent.width;
                    height: parent.height;
                }
            }
            Rectangle { vertical-stretch: 1; }
            ThemedButton {
                text: "Close";
                clicked => { root.closed(); }
            }
        }
    }

    // ---- right detail (6/7) ----
    Rectangle {
        x: parent.width / 7;
        y: 0;
        width: parent.width * 6 / 7;
        height: parent.height;
        background: Theme.bg-canvas;

        // ---- General ----
        if root.tab == 0: VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-xs;
            for row in root.general-rows: Rectangle {
                height: 44px;
                background: Theme.bg-surface;
                border-radius: Theme.radius-md;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    alignment: start;
                    spacing: Theme.space-2;
                    VerticalLayout {
                        alignment: center;
                        Text { text: row.label; color: Theme.text-primary; font-size: Theme.type-body; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Text { text: row.value; color: Theme.text-secondary; font-size: Theme.type-secondary; }
                    }
                    ThemedButton {
                        text: "Apply";
                        width: 80px;
                        clicked => { root.setting-applied(row.action-id); }
                    }
                }
            }
        }

        // ---- Plugins ----
        if root.tab == 1: VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-xs;
            if root.plugins.length == 0: Text {
                text: "No plugins installed. Drop a plugin folder with plugin.json into the plugins directory.";
                color: Theme.text-tertiary;
                font-size: Theme.type-secondary;
                wrap: word-wrap;
            }
            for p in root.plugins: Rectangle {
                height: 52px;
                background: Theme.bg-surface;
                border-radius: Theme.radius-md;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.space-2;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: p.id + "  v" + p.version;
                            color: Theme.text-primary;
                            font-size: Theme.type-body;
                            overflow: elide;
                        }
                        Text {
                            text: p.state-text + " · trust: " + p.trust;
                            color: p.quarantined ? Theme.semantic-error : Theme.text-secondary;
                            font-size: Theme.type-caption;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ThemedButton {
                        text: p.quarantined ? "Quarantined" : (p.enabled ? "Disable" : "Enable");
                        enabled: !p.quarantined;
                        width: 110px;
                        clicked => { root.plugin-toggled(p.id, !p.enabled); }
                    }
                }
            }
        }

        // ---- Workflows ----
        if root.tab == 2: VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-xs;
            if root.workflows.length == 0: Text {
                text: "No workflows installed. JSON definitions live in the workflows directory.";
                color: Theme.text-tertiary;
                font-size: Theme.type-secondary;
                wrap: word-wrap;
            }
            for w in root.workflows: Rectangle {
                height: 48px;
                background: Theme.bg-surface;
                border-radius: Theme.radius-md;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.space-2;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Text { text: w.name; color: Theme.text-primary; font-size: Theme.type-body; overflow: elide; }
                        Text { text: w.path; color: Theme.text-tertiary; font-size: Theme.type-caption; overflow: elide; }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ThemedButton {
                        text: "Delete";
                        width: 90px;
                        clicked => { root.workflow-deleted(w.path); }
                    }
                }
            }
            Text {
                text: "Tip: open the launcher and search 编辑器 to edit a workflow graph.";
                color: Theme.text-tertiary;
                font-size: Theme.type-caption;
            }
        }

        // ---- Windows (P3.1-B1/B2/B3) ----
        if root.tab == 3: VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-xs;
            if root.windows.length == 0: Text {
                text: "No plugin windows discovered. Plugins that declare \"window\": true and are running appear here.";
                color: Theme.text-tertiary;
                font-size: Theme.type-secondary;
                wrap: word-wrap;
            }
            for w in root.windows: Rectangle {
                height: 48px;
                background: root.follow-pick-hwnd == w.hwnd ? Theme.bg-selected : Theme.bg-surface;
                border-radius: Theme.radius-md;
                animate background { duration: Theme.anim-ms * 2ms / 3; }
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    spacing: Theme.space-2;
                    alignment: start;
                    VerticalLayout {
                        alignment: center;
                        Text { text: w.title; color: Theme.text-primary; font-size: Theme.type-body; overflow: elide; }
                        Text {
                            text: "plugin: " + w.plugin-id + (w.follow-target == "" ? "" : "  ·  following: " + w.follow-target);
                            color: Theme.text-tertiary;
                            font-size: Theme.type-caption;
                            overflow: elide;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ThemedButton {
                        text: w.pinned ? "Unpin" : "Pin on top";
                        width: 110px;
                        clicked => { root.pin-toggled(w.hwnd, !w.pinned); }
                    }
                    ThemedButton {
                        text: w.follow-target == "" ? "Follow…" : "Unfollow";
                        width: 100px;
                        clicked => {
                            if (w.follow-target == "") {
                                root.follow-set(w.hwnd, root.follow-pick-hwnd, root.follow-pick-title);
                            } else {
                                root.follow-clear(w.hwnd);
                            }
                        }
                    }
                    ThemedButton {
                        text: w.desktop ? "Unpin desktop" : "To desktop";
                        width: 120px;
                        clicked => { root.desktop-pin-toggled(w.hwnd, !w.desktop); }
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border-subtle; }
            Text {
                text: root.follow-pick-hwnd == ""
                    ? "Select a plugin window above, then pick a running window as the follow target."
                    : "Pick a running window as the follow target for the selected plugin window:";
                color: Theme.text-secondary;
                font-size: Theme.type-caption;
                wrap: word-wrap;
            }
            for t in root.targets: Rectangle {
                height: 36px;
                background: Theme.bg-surface;
                border-radius: Theme.radius-md;
                HorizontalLayout {
                    padding-left: Theme.spacing-md;
                    padding-right: Theme.spacing-md;
                    alignment: start;
                    Text { text: t.title; color: Theme.text-secondary; font-size: Theme.type-secondary; vertical-alignment: center; overflow: elide; }
                    Rectangle { horizontal-stretch: 1; }
                    ThemedButton {
                        text: "Use as target";
                        width: 120px;
                        clicked => { root.follow-pick-title = t.title; }
                    }
                }
            }
        }

        // ---- About ----
        if root.tab == 4: VerticalLayout {
            padding: Theme.spacing-lg;
            spacing: Theme.spacing-md;
            Text { text: "Native Launcher"; color: Theme.text-primary; font-size: Theme.type-title; }
            Text { text: root.about-text; color: Theme.text-secondary; font-size: Theme.type-secondary; wrap: word-wrap; }
        }
    }
}
