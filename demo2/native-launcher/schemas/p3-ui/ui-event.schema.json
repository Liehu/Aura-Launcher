{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aura://schemas/p3-ui/ui-event.schema.json",
  "type": "object",
  "required": [
    "session_id",
    "event_id",
    "node_id",
    "event"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "maxLength": 128
    },
    "event_id": {
      "type": "string",
      "maxLength": 128
    },
    "node_id": {
      "type": "string",
      "maxLength": 128
    },
    "event": {
      "type": "string",
      "enum": [
        "click",
        "change",
        "submit",
        "select",
        "focus",
        "blur",
        "refresh",
        "copy",
        "paste",
        "close"
      ]
    },
    "value": {}
  },
  "additionalProperties": false
}
